ma="main" name="scheidsrechters" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="140"/><column index="2" value="66"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="spelers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="202"/><column index="2" value="60"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="wedstrijden" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="70"/><column index="2" value="47"/><column index="3" value="156"/><column index="4" value="140"/><column index="5" value="140"/><column index="6" value="66"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE VIEW overzicht_gele_kaarten AS
SELECT 
    w.season AS Seizoen,
    w.date AS Datum,
    w.home_team AS Thuisclub,
    w.away_team AS Uitclub,
    s.player AS Speler_Naam,
    gk.team AS Team_Speler,
    gk.cards_yellow AS Aantal_Geel,
    ref.referee AS Scheidsrechter
FROM gele_kaarten gk
-- Koppel de gele kaart aan de wedstrijd
JOIN wedstrijden w ON gk.game_id = w.game_id
-- Koppel de gele kaart aan de speler info
JOIN spelers s ON gk.player_id = s.player_id
-- Koppel de wedstrijd aan de scheidsrechter info
JOIN scheidsrechters ref ON w.referee_id = ref.referee_id
ORDER BY w.date DESC;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
